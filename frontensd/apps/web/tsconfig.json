{
	"include": [
		"**/*.{ts,tsx,js,jsx}",
		"**/.server/**/*",
		"**/.client/**/*",
		"**/.client/**/*",
		".react-router/types/**/*",
		"./src/global.d.ts",
		"./src/vite-env.d.ts"
	],
	"compilerOptions": {
		"lib": [
			"DOM",
			"DOM.Iterable",
			"ES2022"
		],
		"types": [
			"node",
			"vite/client"
		],
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"rootDirs": [
			".",
			"./.react-router/types"
		],
		"baseUrl": ".",
		"esModuleInterop": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"paths": {
			"@/*": [
				"./src/*"
			],
			"npm:stripe": [
				"./node_modules/stripe"
			]
		}
	}
}