{
  "name": "backend",
  "version": "1.0.0",
  "description": "MERN Stack E-commerce App Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "dev": "concurrently \"npm run server\" \"cd ../frontensd/apps/web && npm run dev\"",
    "migrate:seller": "node migrations/migrateSellerData.js",
    "verify:databases": "node migrations/verifyDatabases.js",
    "setup:seller-db": "node migrations/setupSellerDatabase.js",
    "test:seller-db": "node scripts/testSellerDatabase.js",
    "fix:seller-schema": "node scripts/fixSellerDatabaseSchema.js",
    "populate:categories": "node migrations/populateCategories.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.93.1",
    "body-parser": "^1.20.4",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^8.6.0",
    "express": "^4.22.1",
    "express-async-handler": "^1.2.0",
    "multer": "^2.0.2",
    "pg": "^8.17.2",
    "redis": "^4.7.1",
    "razorpay": "^2.9.6",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "concurrently": "^5.3.0",
    "nodemon": "^2.0.22"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}