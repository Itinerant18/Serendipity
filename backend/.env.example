# =====================================================
# BACKEND ENVIRONMENT CONFIGURATION
# =====================================================
# Copy this file to .env and fill in your values
# Never commit the .env file to version control!

# Server Configuration
NODE_ENV=production
PORT=5000

# CORS Origins (comma-separated list of allowed frontend URLs)
CORS_ORIGINS=https://your-frontend-domain.com,http://localhost:4000

# Frontend URL (for redirects and email links)
FRONTEND_URL=https://your-frontend-domain.com

# =====================================================
# SUPABASE CONFIGURATION (Main Database)
# =====================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_anon_public_key
SUPABASE_SERVICE_KEY=your_service_role_key

# =====================================================
# SELLER DATABASE (Separate Supabase instance)
# =====================================================
SELLER_SUPABASE_URL=https://your-seller-project.supabase.co
SELLER_SUPABASE_KEY=your_seller_anon_key
SELLER_SUPABASE_SERVICE_KEY=your_seller_service_key

# =====================================================
# PAYMENT GATEWAY (Razorpay)
# =====================================================
# Get credentials from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# =====================================================
# CACHING (Optional - Redis)
# =====================================================
# If not set, caching will be disabled
# Format: redis://username:password@host:port
REDIS_URL=redis://default:password@redis-host:6379
