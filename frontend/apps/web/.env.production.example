# =====================================================
# PRODUCTION ENVIRONMENT VARIABLES
# =====================================================
# Set these in Railway dashboard → Frontend service → Variables
# These are BUILD-TIME variables - frontend must be redeployed after changes
#
# =====================================================

# Backend API URL (REQUIRED)
VITE_API_URL=https://serendipity-backend.up.railway.app

# Socket.io URL for real-time features (usually same as backend)
VITE_SOCKET_URL=https://serendipity-backend.up.railway.app

# Supabase Configuration
VITE_SUPABASE_URL=<your-supabase-project-url>
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# =====================================================
# SERVER-SIDE ONLY VARIABLES
# =====================================================

# Authentication Secret (generate with: openssl rand -base64 32)
AUTH_SECRET=<your-auth-secret>

# Node Environment
NODE_ENV=production
