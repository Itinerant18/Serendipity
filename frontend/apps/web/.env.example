# =====================================================
# FRONTEND ENVIRONMENT CONFIGURATION
# =====================================================
# Copy this file to .env and fill in your values
# Never commit the .env file to version control!
#
# NOTE: Variables prefixed with VITE_ are available in browser code
# Variables without VITE_ are only available server-side

# =====================================================
# BUILD-TIME VARIABLES (Available in browser)
# =====================================================

# Backend API URL (your deployed backend)
VITE_API_URL=https://your-backend-url.com

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Socket.io URL (usually same as backend)
VITE_SOCKET_URL=https://your-backend-url.com

# =====================================================
# SERVER-SIDE ONLY VARIABLES
# =====================================================

# Authentication Secret (generate with: openssl rand -base64 32)
AUTH_SECRET=generate_a_32_byte_secure_secret

# Node Environment
NODE_ENV=production
